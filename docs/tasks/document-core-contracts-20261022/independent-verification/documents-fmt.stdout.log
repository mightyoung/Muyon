+    let a = DocumentAnchor {
+        document: request().document,
+        location: AnchorLocation::Pdf(pdf()),
+    };
+    assert_eq!(
+        a.validate_for(&request().document),
+        Ok(AnchorStatus::StructurallyValid)
+    );
+    assert_eq!(
+        a.validate_for(&document("project", 2, DocumentFormat::Pdf)),
+        Err(ReadInvalidation::StaleRevision)
+    );
+    assert_eq!(
+        a.validate_for(&document("other", 1, DocumentFormat::Pdf)),
+        Err(ReadInvalidation::ScopeMismatch)
+    );
+    let wrong = DocumentAnchor {
+        document: document("project", 1, DocumentFormat::Docx),
+        location: a.location,
+    };
+    assert_eq!(
+        wrong.validate_for(&wrong.document),
+        Err(ReadInvalidation::FormatMismatch)
+    );
 }
