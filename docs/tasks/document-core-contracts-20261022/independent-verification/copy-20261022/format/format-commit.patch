From 93de8ad99fad105bc3ca32036de30803d87fd6c7 Mon Sep 17 00:00:00 2001
From: yi mu <wolfh1641713779@gmail.com>
Date: Thu, 22 Oct 2026 05:22:47 +0000
Subject: [PATCH] style(documents): format copy-only clone hooks and tests

---
 crates/muyon-core/src/blobs.rs                |   7 +-
 crates/muyon-core/src/documents/storage.rs    |  13 +-
 .../muyon-core/src/documents/storage_tests.rs | 301 +++++++++++++++---
 3 files changed, 274 insertions(+), 47 deletions(-)

diff --git a/crates/muyon-core/src/blobs.rs b/crates/muyon-core/src/blobs.rs
index faa81a98..fec3abe8 100644
--- a/crates/muyon-core/src/blobs.rs
+++ b/crates/muyon-core/src/blobs.rs
@@ -673,7 +673,12 @@ impl BusinessStore {
         )?;
         sql(self.database().exec(
             "INSERT INTO blob_references(reference_id,project_id,target_id,digest) VALUES(?,?,?,?)",
-            &[new_reference_id, project_id, target_id, &expected_blob.digest],
+            &[
+                new_reference_id,
+                project_id,
+                target_id,
+                &expected_blob.digest,
+            ],
         ))?;
         Ok(expected_blob.clone())
     }
diff --git a/crates/muyon-core/src/documents/storage.rs b/crates/muyon-core/src/documents/storage.rs
index 492f5981..7f2063dc 100644
--- a/crates/muyon-core/src/documents/storage.rs
+++ b/crates/muyon-core/src/documents/storage.rs
@@ -392,10 +392,19 @@ impl BusinessStore {
         if changed != 1 {
             return Err(ContractError::RevisionConflict);
         }
-        let metadata = DocumentMetadata { document, title, blob };
+        let metadata = DocumentMetadata {
+            document,
+            title,
+            blob,
+        };
         sql(self.database().exec(
             "INSERT INTO document_revisions VALUES(?,?,?,?)",
-            &[project, base.document_id(), revision.as_str(), &encode(&metadata)?],
+            &[
+                project,
+                base.document_id(),
+                revision.as_str(),
+                &encode(&metadata)?,
+            ],
         ))?;
         Ok(metadata)
     }
diff --git a/crates/muyon-core/src/documents/storage_tests.rs b/crates/muyon-core/src/documents/storage_tests.rs
index 0936076d..a7420bd0 100644
--- a/crates/muyon-core/src/documents/storage_tests.rs
+++ b/crates/muyon-core/src/documents/storage_tests.rs
@@ -181,23 +181,69 @@ fn copy_clone_commits_same_bytes_and_revision_without_upload_or_staging() {
     let f = Fixture::new();
     let (store, access) = f.setup();
     let original = store.read_document(&access).unwrap();
-    let before_uploads = store.database().query("SELECT * FROM blob_uploads", &[]).unwrap();
-    let before_pins = store.database().query("SELECT * FROM blob_pins", &[]).unwrap();
+    let before_uploads = store
+        .database()
+        .query("SELECT * FROM blob_uploads", &[])
+        .unwrap();
+    let before_pins = store
+        .database()
+        .query("SELECT * FROM blob_pins", &[])
+        .unwrap();
     let tx = store.database().transaction().unwrap();
-    store.document_access_in_transaction(&tx, &access, &[DocumentOperation::StructuredEdit]).unwrap();
-    let copy = store.document_clone_in_transaction(&tx, &access.document, "COPY only", &original.blob).unwrap();
+    store
+        .document_access_in_transaction(&tx, &access, &[DocumentOperation::StructuredEdit])
+        .unwrap();
+    let copy = store
+        .document_clone_in_transaction(&tx, &access.document, "COPY only", &original.blob)
+        .unwrap();
     assert_eq!(copy.blob, original.blob);
     assert_eq!(copy.document.format(), original.document.format());
     assert_eq!(copy.document.revision(), &Revision::new(2));
-    store.document_grant_in_transaction(&tx, &access, &[DocumentOperation::StructuredEdit]).unwrap();
+    store
+        .document_grant_in_transaction(&tx, &access, &[DocumentOperation::StructuredEdit])
+        .unwrap();
     tx.commit().unwrap();
-    assert_eq!(store.database().query("SELECT * FROM blob_uploads", &[]).unwrap(), before_uploads);
-    assert_eq!(store.database().query("SELECT * FROM blob_pins", &[]).unwrap(), before_pins);
-    assert_eq!(fs::read_dir(store.root_dir().join("staging")).unwrap().count(), 0);
-    assert_eq!(store.database().query("SELECT * FROM document_revisions", &[]).unwrap().len(), 2);
-    assert_eq!(store.database().query("SELECT * FROM blob_references", &[]).unwrap().len(), 2);
+    assert_eq!(
+        store
+            .database()
+            .query("SELECT * FROM blob_uploads", &[])
+            .unwrap(),
+        before_uploads
+    );
+    assert_eq!(
+        store
+            .database()
+            .query("SELECT * FROM blob_pins", &[])
+            .unwrap(),
+        before_pins
+    );
+    assert_eq!(
+        fs::read_dir(store.root_dir().join("staging"))
+            .unwrap()
+            .count(),
+        0
+    );
+    assert_eq!(
+        store
+            .database()
+            .query("SELECT * FROM document_revisions", &[])
+            .unwrap()
+            .len(),
+        2
+    );
+    assert_eq!(
+        store
+            .database()
+            .query("SELECT * FROM blob_references", &[])
+            .unwrap()
+            .len(),
+        2
+    );
     let mut reader = store.open_blob_reader("project", &original.blob).unwrap();
-    assert_eq!(store.read_blob_chunk(&mut reader, 4096).unwrap(), b"%PDF-1.4\noriginal synthetic hook fixture\n%%EOF\n");
+    assert_eq!(
+        store.read_blob_chunk(&mut reader, 4096).unwrap(),
+        b"%PDF-1.4\noriginal synthetic hook fixture\n%%EOF\n"
+    );
 }
 
 #[test]
@@ -206,17 +252,62 @@ fn clone_and_late_receipt_failure_roll_back_together() {
     let (store, access) = f.setup();
     let original = store.read_document(&access).unwrap();
     // Synthetic receipt constraint, not the gateway owner's production journal.
-    store.database().exec("CREATE TABLE synthetic_copy_receipts(id TEXT PRIMARY KEY)", &[]).unwrap();
-    store.database().exec("INSERT INTO synthetic_copy_receipts VALUES('existing')", &[]).unwrap();
+    store
+        .database()
+        .exec(
+            "CREATE TABLE synthetic_copy_receipts(id TEXT PRIMARY KEY)",
+            &[],
+        )
+        .unwrap();
+    store
+        .database()
+        .exec(
+            "INSERT INTO synthetic_copy_receipts VALUES('existing')",
+            &[],
+        )
+        .unwrap();
     let tx = store.database().transaction().unwrap();
-    store.document_clone_in_transaction(&tx, &access.document, "COPY only", &original.blob).unwrap();
-    assert!(store.database().exec("INSERT INTO synthetic_copy_receipts VALUES('existing')", &[]).is_err());
+    store
+        .document_clone_in_transaction(&tx, &access.document, "COPY only", &original.blob)
+        .unwrap();
+    assert!(store
+        .database()
+        .exec(
+            "INSERT INTO synthetic_copy_receipts VALUES('existing')",
+            &[]
+        )
+        .is_err());
     drop(tx);
     assert_eq!(store.read_document(&access).unwrap(), original);
-    assert_eq!(store.database().query("SELECT * FROM document_revisions", &[]).unwrap().len(), 1);
-    assert_eq!(store.database().query("SELECT * FROM blob_references", &[]).unwrap().len(), 1);
-    assert_eq!(store.database().query("SELECT * FROM blob_uploads", &[]).unwrap().len(), 1);
-    assert!(store.database().query("SELECT * FROM blob_pins", &[]).unwrap().is_empty());
+    assert_eq!(
+        store
+            .database()
+            .query("SELECT * FROM document_revisions", &[])
+            .unwrap()
+            .len(),
+        1
+    );
+    assert_eq!(
+        store
+            .database()
+            .query("SELECT * FROM blob_references", &[])
+            .unwrap()
+            .len(),
+        1
+    );
+    assert_eq!(
+        store
+            .database()
+            .query("SELECT * FROM blob_uploads", &[])
+            .unwrap()
+            .len(),
+        1
+    );
+    assert!(store
+        .database()
+        .query("SELECT * FROM blob_pins", &[])
+        .unwrap()
+        .is_empty());
 }
 
 #[test]
@@ -225,16 +316,49 @@ fn clone_rejects_changed_source_stale_base_and_foreign_transaction() {
     let (store, access) = f.setup();
     let original = store.read_document(&access).unwrap();
     let tx = store.database().transaction().unwrap();
-    for wrong in [BlobRef { digest: "b".repeat(64), ..original.blob.clone() }, BlobRef { byte_length: original.blob.byte_length.next().unwrap(), ..original.blob.clone() }] {
-        assert_eq!(store.document_clone_in_transaction(&tx, &access.document, "COPY", &wrong), Err(ContractError::BindingMismatch));
+    for wrong in [
+        BlobRef {
+            digest: "b".repeat(64),
+            ..original.blob.clone()
+        },
+        BlobRef {
+            byte_length: original.blob.byte_length.next().unwrap(),
+            ..original.blob.clone()
+        },
+    ] {
+        assert_eq!(
+            store.document_clone_in_transaction(&tx, &access.document, "COPY", &wrong),
+            Err(ContractError::BindingMismatch)
+        );
     }
-    let stale = DocumentRef::new(access.document.scope().clone(), "document", Revision::new(0), DocumentFormat::Pdf).unwrap();
-    assert_eq!(store.document_clone_in_transaction(&tx, &stale, "COPY", &original.blob), Err(ContractError::RevisionConflict));
+    let stale = DocumentRef::new(
+        access.document.scope().clone(),
+        "document",
+        Revision::new(0),
+        DocumentFormat::Pdf,
+    )
+    .unwrap();
+    assert_eq!(
+        store.document_clone_in_transaction(&tx, &stale, "COPY", &original.blob),
+        Err(ContractError::RevisionConflict)
+    );
     drop(tx);
     let foreign = Db::open(":memory:", false, true).unwrap();
     let foreign_tx = foreign.transaction().unwrap();
-    assert_eq!(store.document_clone_in_transaction(&foreign_tx, &access.document, "COPY", &original.blob), Err(ContractError::InvalidAuthority));
-    assert_eq!(store.clone_blob_reference_in_transaction(&foreign_tx, "project", "document", &original.blob, "new-ref"), Err(ContractError::InvalidAuthority));
+    assert_eq!(
+        store.document_clone_in_transaction(&foreign_tx, &access.document, "COPY", &original.blob),
+        Err(ContractError::InvalidAuthority)
+    );
+    assert_eq!(
+        store.clone_blob_reference_in_transaction(
+            &foreign_tx,
+            "project",
+            "document",
+            &original.blob,
+            "new-ref"
+        ),
+        Err(ContractError::InvalidAuthority)
+    );
 }
 
 #[test]
@@ -242,19 +366,50 @@ fn clone_reference_requires_same_project_ready_source_and_unique_reference() {
     let f = Fixture::new();
     let (store, access) = f.setup();
     let original = store.read_document(&access).unwrap();
-    store.database().exec("INSERT INTO projects VALUES('other','workspace','Other','1',0)", &[]).unwrap();
+    store
+        .database()
+        .exec(
+            "INSERT INTO projects VALUES('other','workspace','Other','1',0)",
