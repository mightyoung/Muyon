  "extra_test_source": "\n#[test]\nfn independent_registry_workspace_rejects() { check_receipt_tail_trigger(\"UPDATE local_bot_draft_meta SET workspace='wrong-workspace'\"); }\n#[test]\nfn independent_registry_schema_rejects() { check_receipt_tail_trigger(\"UPDATE local_bot_draft_meta SET schema_version='2'\"); }\n#[test]\nfn independent_registry_archive_blob_rejects() { check_receipt_tail_trigger(\"UPDATE local_bot_drafts SET archive_hex=CAST(archive_hex AS BLOB) WHERE project_id='p1'\"); }\n#[test]\nfn independent_registry_digest_blob_rejects() { check_receipt_tail_trigger(\"UPDATE local_bot_drafts SET archive_digest=CAST(archive_digest AS BLOB) WHERE project_id='p1'\"); }\n#[test]\nfn independent_entry_revoked_cannot_be_restored_by_insert() {\n let f=project_fixture();\n let r=prepare_create(f.store(), CONVERSATION, Some(\"p1\"), &f.binding, INTENT).unwrap();\n f.store().database().exec(\"CREATE TRIGGER regrant_on_insert AFTER INSERT ON local_bot_definitions BEGIN UPDATE projects SET deleted=0 WHERE id='p1'; END\",&[]).unwrap();\n let result=confirm_create_with_boundary(f.store(),CONVERSATION,Some(\"p1\"),INTENT,&r.review_digest,|| {sql(f.store().database().exec(\"UPDATE projects SET deleted=1 WHERE id='p1'\",&[]))?;Ok(())});\n assert_eq!(result.unwrap_err(),\"bot_query_original\");\n assert_original_pending_zero_definitions(&f);\n}\n",
