+#[test]
+fn successful_outbox_update_and_ack_tampering_cannot_report_success() {
+    for acknowledge in [false, true] {
+        let (_f, store, mut source, mut local, kind) = fixture();
+        store.revoke_document_grant_trusted(&source.authority).unwrap();
+        let first = store.pending_document_source_notifications_trusted(None, 256).unwrap();
+        if acknowledge {
+            store.database().exec("CREATE TRIGGER tamper AFTER UPDATE ON document_source_notifications_v1 WHEN NEW.pending=0 BEGIN UPDATE document_source_notifications_v1 SET pending=1 WHERE object_id=NEW.object_id; END", &[]).unwrap();
+            assert!(store.ack_document_source_notifications_trusted(&first).is_err());
+            assert_eq!(store.pending_document_source_notifications_trusted(None, 256).unwrap(), first);
+        } else {
+            store.ack_document_source_notifications_trusted(&first).unwrap();
+            source.authority.generation = source.authority.generation.next().unwrap();
+            store.issue_document_grant_trusted(&source.document, &source.authority, &[DocumentOperation::Inspect, DocumentOperation::ReadText], expiry()).unwrap();
+            local.binding_generation = local.binding_generation.next().unwrap();
+            bind(&store, &source, &local, &kind);
+            store.database().exec("CREATE TRIGGER tamper AFTER UPDATE ON document_source_notifications_v1 WHEN NEW.pending=1 BEGIN UPDATE document_grants SET active=1 WHERE grant_id='source-grant'; END", &[]).unwrap();
+            assert!(store.revoke_document_grant_trusted(&source.authority).is_err());
+            assert!(store.read_document(&source).is_ok()); assert_eq!(active(&store), "1");
+            assert!(store.pending_document_source_notifications_trusted(None, 256).unwrap().is_empty());
+        }
+    }
+}
