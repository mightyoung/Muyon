+            if generation.value() == 0 { return Err(ContractError::StorageCorrupt); }
+            events.push(DocumentSourceNotification { project_id: cell(&row, 0)?.into(), actor_id: cell(&row, 1)?.into(), object_id: cell(&row, 2)?.into(), generation });
