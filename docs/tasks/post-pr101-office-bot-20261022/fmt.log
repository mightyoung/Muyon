+fn generic_ports_share_driver_without_inquiry_names() {
+    let dir = std::env::temp_dir().join(format!(
+        "native-core-{}-{}",
+        std::process::id(),
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos()
+    ));
+    std::fs::create_dir_all(&dir).unwrap();
+    let state = State::runtime("weather?".into(), "scope".into(), Limits::default()).unwrap();
+    assert!(state.script.is_empty());
+    assert!(!dir.join("effects.db").exists());
+    let mut a = Agent { dir, state };
+    let mut p = Ports {
+        dispatches: 0,
+        persists: std::cell::Cell::new(0),
+    };
+    let mut m = Model { turns: 0 };
+    a.run_with_runtime_ports(&mut m, &mut p, &Hooks::default())
+        .unwrap();
+    if a.state.reason == "native_ports_unsupported" {
