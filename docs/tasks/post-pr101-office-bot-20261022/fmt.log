+                    let escape = *self.bytes.get(self.pos).ok_or("wire_json_escape")?;
+                    self.pos += 1;
+                    match escape {
+                        b'"' | b'\\' | b'/' => out.push(escape),
+                        b'b' => out.push(8),
+                        b'f' => out.push(12),
+                        b'n' => out.push(b'\n'),
+                        b'r' => out.push(b'\r'),
+                        b't' => out.push(b'\t'),
+                        b'u' => {
+                            let mut cp = self.hex4()?;
+                            if (0xD800..=0xDBFF).contains(&cp) {
+                                self.require(b'\\')?;
+                                self.require(b'u')?;
