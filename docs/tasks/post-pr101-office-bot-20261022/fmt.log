+fn wire(lines: &str) -> Vec<muyon_plugin_contract_lab::Json> {
+    use std::io::{Read, Write};
+    use std::process::{Command, Stdio};
+    use std::sync::mpsc;
+    use std::time::{Duration, Instant};
+    struct OwnedChild(std::process::Child);
+    impl Drop for OwnedChild {
+        fn drop(&mut self) {
+            if self.0.try_wait().ok().flatten().is_some() {
+                return;
+            }
+            // A panicking test kills only its owned child and polls to reap it.
+            let _ = self.0.kill();
+            let until = Instant::now() + Duration::from_secs(1);
+            while self.0.try_wait().ok().flatten().is_none() && Instant::now() < until {
+                std::thread::sleep(Duration::from_millis(5));
+            }
+        }
+    }
+    let mut owned = OwnedChild(
+        Command::new(env!("CARGO_BIN_EXE_muyon-plugin-contract-lab"))
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()
+            .unwrap(),
+    );
+    let child = &mut owned.0;
+    let mut input = child.stdin.take().unwrap();
+    let output = child.stdout.take().unwrap();
+    let owned = lines.as_bytes().to_vec();
+    let (tx, rx) = mpsc::channel();
+    std::thread::spawn(move || {
+        let _ = input.write_all(&owned);
+        drop(input);
+    });
+    std::thread::spawn(move || {
+        let mut bytes = Vec::new();
+        let result = output.take(1048577).read_to_end(&mut bytes);
+        let _ = tx.send((result, bytes));
+    });
+    let deadline = Instant::now() + Duration::from_secs(5);
+    let status = loop {
+        if let Some(status) = child.try_wait().unwrap() {
+            break status;
+        }
+        if Instant::now() >= deadline {
+            let _ = child.kill();
+            let cleanup = Instant::now() + Duration::from_secs(1);
+            while child.try_wait().unwrap().is_none() && Instant::now() < cleanup {
+                std::thread::sleep(Duration::from_millis(5));
+            }
+            panic!("owned wire child exceeded bounded deadline");
+        }
+        std::thread::sleep(Duration::from_millis(5));
+    };
+    let (result, bytes) = rx
+        .recv_timeout(Duration::from_secs(1))
+        .expect("bounded stdout collection");
+    result.unwrap();
+    assert!(bytes.len() <= 1048576);
+    assert!(status.success());
+    String::from_utf8(bytes)
+        .unwrap()
+        .lines()
+        .map(json)
+        .collect()
 }
 
