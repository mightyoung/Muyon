+fn compose_contract_reaches_same_agent_with_frozen_plain_text_and_no_supplier_authority() {
+    let f = Arc::new(Mutex::new(Facts::default()));
+    let (path, c, client) = open(f.clone());
+    let reply = submit(&c, &client, "chat1", "请概括普通文本");
+    assert_eq!(reply.object().unwrap()["terminal"], Json::Bool(true));
+    let events = reply.object().unwrap()["events"].array().unwrap();
+    assert_eq!(events.len(), 3, "{}", reply.encode());
+    assert_eq!(
+        events[0].object().unwrap()["payload"].object().unwrap()["text"],
+        string("离线普通文本响应")
+    );
+    assert!(!reply.encode().contains("supplier_projection"));
+    assert!(reply.encode().contains("provider_receipt"));
+    assert!(reply.encode().contains("completed"));
+    let run = reply.object().unwrap()["run_id"].string().unwrap();
+    let dir = path.join("native-agent-service-v1").join(run);
+    assert!(dir.join("ordinary-agent-v1.db").is_file());
+    assert!(!dir.join("task.db").exists());
+    assert!(!dir.join("native.db").exists());
+    let frozen = parse(&std::fs::read(dir.join("ordinary-send-v1.db")).unwrap()).unwrap();
+    assert_eq!(
+        frozen.object().unwrap()["context"].object().unwrap()["conversation"],
+        string("conversation-current")
+    );
+    assert!(frozen.encode().contains("USER-TEXT-v1"));
+    let sent = f.lock().unwrap().payloads[0].clone();
+    assert_eq!(
+        parse(&sent).unwrap().object().unwrap()["model"],
+        string("fixture-chat-model")
+    );
+    assert_eq!(
+        parse(&sent).unwrap().object().unwrap()["messages"]
+            .array()
+            .unwrap()[0]
+            .object()
+            .unwrap()["content"],
+        string("请概括普通文本")
+    );
+    assert_eq!(frozen.object().unwrap()["payload"], parse(&sent).unwrap());
+    let duplicate = submit(&c, &client, "chat1", "请概括普通文本");
+    assert!(duplicate.encode().contains("completed"));
+    assert_eq!(f.lock().unwrap().sends, 1);
+    f.lock().unwrap().revoked = true;
+    let denied = c.supplier_read_events(client, "chat1".into(), 0);
+    assert!(denied.contains("DISCLOSURE_UNAVAILABLE"));
+    assert!(!denied.contains("离线普通文本响应"));
+    clean(path, c);
 }
