+fn pipe_end(fd: i32) -> (bool, bool) {
+    #[repr(C)]
+    struct PollFd {
+        fd: i32,
+        events: i16,
+        revents: i16,
+    }
+    unsafe extern "C" {
+        fn poll(fds: *mut PollFd, nfds: usize, timeout: i32) -> i32;
+        fn ioctl(fd: i32, request: usize, ...) -> i32;
+    }
+    let mut p = PollFd {
+        fd,
+        events: 1,
+        revents: 0,
+    };
+    let mut available: i32 = 0;
+    let ready = unsafe { poll(&mut p, 1, 0) };
