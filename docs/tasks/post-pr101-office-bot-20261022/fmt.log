+pub fn validate_refs(s: &Json, v: &Json, a: &Json) -> Result<()> {
+    if let Some(target) = map(s)?.get("data_ref") {
+        if reference_value(v)? != target.string().map_err(|_| "data_ref")? {
+            return Err("result_reference_type".into());
+        }
+        if !array(a, "refs")?.contains(v) {
+            return Err("result_reference".into());
+        }
+        return Ok(());
+    }
+    match text(s, "type")?.as_str() {
+        "object" => {
+            for (k, value) in map(v)? {
+                validate_refs(&map(get(s, "properties")?)?[k], value, a)?;
+            }
+        }
+        "array" => {
+            for value in v.array().map_err(|_| "array_required")? {
