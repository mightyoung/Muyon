+fn mode_name(mode: Mode) -> &'static str {
+    match mode {
+        Mode::ReadOnly => "read-only",
+        Mode::AskEveryTime => "ask-every-time",
+        Mode::Auto => "auto",
+        Mode::FullAllow => "full-allow",
+    }
+}
+pub fn parse_mode(s: &str) -> Result<Mode> {
+    match s {
+        "read-only" => Ok(Mode::ReadOnly),
+        "ask-every-time" => Ok(Mode::AskEveryTime),
+        "auto" => Ok(Mode::Auto),
+        "full-allow" => Ok(Mode::FullAllow),
+        _ => Err("invalid_mode".into()),
+    }
+}
+pub fn boolean(s: &str) -> Result<bool> {
+    match s {
+        "true" => Ok(true),
+        "false" => Ok(false),
+        _ => Err("invalid_boolean".into()),
+    }
