+pub(crate) fn units(context: &Json) -> Result<Vec<Json>> {
+    if !versioned(context)? {
+        return Ok(vec![]);
+    }
+    let rows = field(context, "history")?.array()?;
+    if rows.len() > MAX_TURNS {
+        return Err("chat_context_limit".into());
+    }
+    let mut seen = std::collections::BTreeSet::new();
+    for (index, row) in rows.iter().enumerate() {
+        closed(
+            row,
+            &[
+                "request",
+                "run",
+                "epoch",
+                "build",
+                "task",
+                "attempt",
+                "input_ref",
+                "receipt",
+                "authority",
+                "user",
+                "answer",
+                "ancestors",
+            ],
+        )?;
+        let run = text(row, "run")?;
+        if !hex(run, 32)
+            || !hex(text(row, "epoch")?, 32)
+            || !hex(text(row, "build")?, 40)
+            || !seen.insert(run.to_owned())
+        {
+            return Err("chat_history_unavailable".into());
         }
+        for key in ["request", "task", "attempt", "input_ref", "receipt"] {
+            let v = text(row, key)?;
+            if v.is_empty() || v.len() > 512 || v.chars().any(char::is_control) {
+                return Err("chat_history_unavailable".into());
+            }
+        }
+        if text(row, "input_ref")? != format!("{run}:{}", text(row, "request")?) {
+            return Err("chat_history_unavailable".into());
+        }
+        let auth = field(row, "authority")?;
+        if field(auth, "workspace")? != field(context, "workspace")?
+            || field(auth, "conversation")? != field(context, "conversation")?
+        {
+            return Err("chat_history_unavailable".into());
+        }
+        ordinary_chat::check_text(text(row, "user")?)?;
+        ordinary_chat::check_text(text(row, "answer")?)?;
+        let mut ancestors = std::collections::BTreeSet::new();
+        let mut previous = None;
+        for a in field(row, "ancestors")?.array()? {
+            let id = a.string()?;
+            if id == run || !seen.contains(id) || !ancestors.insert(id) {
+                return Err("chat_history_unavailable".into());
+            }
+            let position = rows[..index]
+                .iter()
+                .position(|u| field(u, "run").ok() == Some(&string(id)))
+                .ok_or("chat_history_unavailable")?;
+            if previous.is_some_and(|p| p >= position) {
+                return Err("chat_history_unavailable".into());
+            }
+            previous = Some(position);
+        }
     }
     Ok(rows.to_vec())
 }
