+fn changed_frozen_usage_or_profile_evidence_cannot_disclose_completed_answer() {
+    for change in ["usage", "profile"] {
+        let f = Arc::new(Mutex::new(Facts::default()));
+        let (path, c, client) = open(f);
+        let reply = submit(&c, &client, "evidence1", "hello");
+        let run = reply.object().unwrap()["run_id"].string().unwrap();
+        let file = path
+            .join("native-agent-service-v1")
+            .join(run)
+            .join("ordinary-send-v1.db");
+        let mut data = parse(&std::fs::read(&file).unwrap()).unwrap();
+        if let Json::Object(fields) = &mut data {
+            if change == "usage" {
+                fields.insert(
+                    "usage".into(),
+                    parse(
+                        br#"{"input":1,"output":999999,"counting_rule":"synthetic-byte-bound-v1"}"#,
+                    )
+                    .unwrap(),
+                );
+            } else if let Some(Json::Object(provider)) = fields.get_mut("provider") {
+                provider.remove("endpoint");
+            }
+        }
+        std::fs::write(file, data.encode()).unwrap();
+        let denied = c.supplier_read_events(client, "evidence1".into(), 0);
+        assert!(denied.contains("DISCLOSURE_UNAVAILABLE"));
+        assert!(!denied.contains("离线普通文本响应"));
+        clean(path, c);
     }
 }
