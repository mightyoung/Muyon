+fn provider_evidence(a: &ProviderAdmission) -> Json {
+    let b = a.binding();
+    let p = a.profile();
+    object([
+        ("profile_id", string(&p.id)),
+        (
+            "location",
+            string(match p.location {
+                ModelLocation::Remote => "remote",
+                ModelLocation::OwnDevice => "own-device",
+            }),
+        ),
+        ("purpose", string("chat")),
+        ("credential_ref", string(&p.credential_ref)),
+        ("model_allowed", Json::Bool(b.model_allowed)),
+        ("outbound_allowed", Json::Bool(b.outbound_allowed)),
+        ("endpoint", string(&p.endpoint)),
+        ("endpoint_identity", string(&p.endpoint_identity)),
+        ("provider", string(&p.provider)),
+        ("model", string(&p.model)),
+        ("profile_revision", string(&b.profile_revision)),
+        ("policy_revision", string(&b.policy_revision)),
+        ("grant_revision", string(&b.grant_revision)),
+        ("authorization_owner", string(&b.authorization_owner)),
+        (
+            "credential_identity",
+            string(a.credential_handle().identity()),
+        ),
+        (
+            "credential_generation",
+            Json::Number(a.credential_handle().generation().unwrap_or(0).to_string()),
+        ),
+        ("budget_revision", string(&b.budget.revision)),
+        ("quota_proof", string(&b.budget.quota_proof)),
+        (
+            "max_tokens",
+            Json::Number(a.call_budget().max_tokens.to_string()),
+        ),
+        (
+            "max_micros",
+            Json::Number(a.call_budget().max_micros.to_string()),
+        ),
+    ])
+}
+pub const LIVE_BATCH: &str = "muyon-ordinary-chat-20261019-cny1-two-requests";
+const LIVE_FOLLOWUP_BATCH: &str = "muyon-ordinary-chat-20261020-authorized-followup";
+fn approved_live_grant(batch: &str) -> Option<&'static str> {
+    match batch {
+        LIVE_BATCH => Some("canary-grant-v1"),
+        LIVE_FOLLOWUP_BATCH => Some("canary-followup-grant-v1"),
+        _ => None,
+    }
+}
+pub const LIVE_QUOTA: &str = "deepseek-flash-1017-full-prompt-bound-cny-v1";
+pub const LIVE_COUNTING: &str = "deepseek-flash-1017-bpe-upper-v1";
+pub const LIVE_PRICE: &str = "deepseek-cny-peak-miss-20261020-v1";
+pub(crate) fn live(b: &BusinessRead) -> bool {
+    b.source_binding
+        .as_ref()
+        .and_then(|c| field(c, "authority").ok())
+        .and_then(|a| field(a, "synthetic").ok())
+        == Some(&Json::Bool(false))
+}
+fn live_profile(
+    profile: &crate::service_provider::ConfiguredProfile,
+    budget: &crate::service_provider::CallBudget,
+) -> Result<()> {
+    if profile.id != "ordinary-deepseek-flash-canary"
+        || profile.endpoint != "https://api.deepseek.com/chat/completions"
+        || profile.endpoint_identity != "deepseek-https-chat-v1"
+        || profile.provider != "deepseek"
+        || profile.model != "deepseek-flash"
+        || profile.location != ModelLocation::Remote
+        || budget.max_tokens != 16512
+        || budget.max_micros != 33792
+        || budget.requires_tools
+        || budget.requires_streaming
+    {
+        return Err("chat_live_configuration".into());
+    }
+    Ok(())
+}
+fn write_send(
+    dir: &Path,
+    context: &Json,
+    body: &Json,
+    state: &str,
+    admission: Option<&ProviderAdmission>,
+    response: Option<&ChatResponse>,
+) -> Result<()> {
+    let is_live = field(field(context, "authority")?, "synthetic")? == &Json::Bool(false);
+    let live_batch = if is_live && response.is_some() {
+        let binding = admission.ok_or("chat_live_configuration")?.binding();
+        let batch = binding.budget.revision.as_str();
+        if approved_live_grant(batch) != Some(binding.grant_revision.as_str()) {
+            return Err("chat_live_configuration".into());
+        }
+        batch
+    } else {
+        ""
+    };
+    let usage = response
+        .map(|r| {
+            if is_live {
+                object([
+                    ("input", Json::Number(r.input_tokens.to_string())),
+                    ("output", Json::Number(r.output_tokens.to_string())),
+                    ("counting_rule", string(LIVE_COUNTING)),
+                    ("price_rule", string(LIVE_PRICE)),
+                    ("currency", string("CNY")),
+                    ("batch", string(live_batch)),
+                    (
+                        "fee_upper_micro_cny",
+                        Json::Number((r.input_tokens * 2 + r.output_tokens * 8).to_string()),
+                    ),
+                ])
+            } else {
+                object([
+                    ("input", Json::Number(r.input_tokens.to_string())),
+                    ("output", Json::Number(r.output_tokens.to_string())),
+                    ("counting_rule", string("synthetic-byte-bound-v1")),
+                ])
+            }
+        })
+        .unwrap_or(Json::Null);
+    let encoded = object([
+        (
+            "version",
+            string(if is_live {
+                "ordinary-send-live-v1"
+            } else {
+                "ordinary-send-v1"
+            }),
+        ),
+        ("context", context.clone()),
+        ("payload", body.clone()),
+        ("state", string(state)),
+        (
+            "admission",
+            string(admission.map(|a| a.record_id()).unwrap_or("")),
+        ),
+        (
+            "provider",
+            admission.map(provider_evidence).unwrap_or(Json::Null),
+        ),
+        (
+            "answer",
+            string(response.map(|r| r.answer.as_str()).unwrap_or("")),
+        ),
+        ("usage", usage),
+    ])
+    .encode();
+    if encoded.len() > 65536 {
+        return Err("chat_context_limit".into());
+    }
+    store::atomic(dir, "ordinary-send-v1.db", &encoded)
+}
+fn preflight(source: &BusinessRead, context: &Json, body: &Json, output: u64) -> Result<()> {
+    let mut worst = source.clone();
+    worst.events.clear();
+    worst.push(
+        "answer_delta",
+        object([("text", string("\\".repeat(output as usize)))]),
+    );
+    worst.push(
+        "provider_receipt",
+        object([
+            ("owner", string("ServiceProviderOwner")),
+            ("identity", string("r".repeat(512))),
+            ("task", field(context, "task")?.clone()),
+            ("attempt", field(context, "attempt")?.clone()),
+            ("synthetic", Json::Bool(true)),
+        ]),
+    );
+    worst.push(
+        "terminal",
+        object([("state", string("completed")), ("reason", string("none"))]),
+    );
