+    let (lock, signal) = &*gate;
+    let state = lock.lock().unwrap();
+    let (mut state, timeout) = signal
+        .wait_timeout_while(state, std::time::Duration::from_secs(10), |s| !s.0)
+        .unwrap();
+    let entered = state.0 && !timeout.timed_out();
+    drop(state);
+    let cancellation = c.cancel(AgentCancelRequest {
+        client: client.clone(),
+        run: AgentRunRef {
+            request_id: "cancel-second".into(),
+            variant: AgentReadVariant::Inquiry,
+            run_id: None,
+        },
+    });
+    state = lock.lock().unwrap();
+    state.1 = true;
+    signal.notify_all();
+    drop(state);
+    c.await_settled();
+    assert!(entered, "synthetic handoff must enter before cancellation");
+    assert!(matches!(
+        cancellation.outcome,
+        AgentControlOutcome::Requested
+    ));
+    let result = parse(
+        c.supplier_read_events(client.clone(), "cancel-second".into(), 0)
+            .as_bytes(),
+    )
+    .unwrap();
+    assert!(result.encode().contains("outcome_unknown"));
+    assert!(!result.encode().contains("离线普通文本响应"));
+    for _ in 0..3 {
+        let replay = submit(&c, &client, "cancel-second", "distinct current turn");
+        assert_eq!(replay, result);
+    }
+    let facts = f.lock().unwrap();
+    assert_eq!(facts.sends, 2);
+    assert_eq!(facts.attempts.len(), 2);
+    let wire = parse(&facts.payloads[1]).unwrap();
+    let messages = wire.object().unwrap()["messages"].array().unwrap();
+    assert_eq!(messages.len(), 3);
+    assert_eq!(
+        messages[0].object().unwrap()["content"],
+        string("first permitted turn")
+    );
+    assert_eq!(
+        messages[2].object().unwrap()["content"],
+        string("distinct current turn")
+    );
+    drop(facts);
+    clean(path, c);
 }
 
