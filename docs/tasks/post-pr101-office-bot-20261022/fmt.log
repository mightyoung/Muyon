+        c.charge(true, 4)?;
+        assert_eq!(c.remaining(), 5, "host send uses the existing total budget");
+        c.charge(false, 3)?;
+        c.checkpoint("meter")?;
+        assert_eq!(c.remaining(), 2);
+        if self.exhaust {
