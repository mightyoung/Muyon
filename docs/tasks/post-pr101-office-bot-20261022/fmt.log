+fn live_source_is_frozen_before_first_admitted_run_id_and_never_flips_on_unknown_or_read_error() {
+    for cancel in [false, true] {
+        let gate = Arc::new((Mutex::new((false, false)), Condvar::new()));
+        let f = Arc::new(Mutex::new(Facts {
+            authority_gate: Some(gate.clone()),
+            ..Facts::default()
+        }));
+        let (path, c, client) = open(f.clone());
+        let queued = parse(
+            c.submit_ordinary_chat(
+                client.clone(),
+                "early".into(),
+                "fixture-conversation".into(),
+                "synthetic input".into(),
+            )
+            .as_bytes(),
+        )
+        .unwrap();
+        assert_eq!(queued.object().unwrap()["synthetic"], Json::Bool(false));
+        let (lock, signal) = &*gate;
+        let state = lock.lock().unwrap();
+        let (state, timeout) = signal
+            .wait_timeout_while(state, std::time::Duration::from_secs(10), |s| !s.0)
+            .unwrap();
+        assert!(!timeout.timed_out() && state.0);
+        drop(state);
+        let admitted = events(&c, &client, "early");
+        assert_eq!(admitted.object().unwrap()["synthetic"], Json::Bool(false));
+        assert_ne!(admitted.object().unwrap()["run_id"], Json::Null);
+        assert!(admitted.object().unwrap()["events"]
+            .array()
+            .unwrap()
+            .is_empty());
+        let run = admitted.object().unwrap()["run_id"]
+            .string()
+            .unwrap()
+            .to_owned();
+        assert!(
+            !path
+                .join("native-agent-service-v1")
+                .join(&run)
+                .join("source.db")
+                .exists(),
+            "the test must observe admission before context freeze"
+        );
+        if cancel {
+            c.cancel(AgentCancelRequest {
+                client: client.clone(),
+                run: AgentRunRef {
+                    request_id: "early".into(),
+                    variant: AgentReadVariant::Inquiry,
+                    run_id: None,
+                },
+            });
+        }
+        {
+            let mut state = lock.lock().unwrap();
+            state.1 = true;
+            signal.notify_all();
+        }
+        c.await_settled();
+        let final_reply = events(&c, &client, "early");
+        assert_eq!(
+            final_reply.object().unwrap()["synthetic"],
+            Json::Bool(false)
+        );
+        assert_eq!(completed(&final_reply), !cancel);
+        let bad_cursor = parse(
+            c.supplier_read_events(client.clone(), "early".into(), -1)
+                .as_bytes(),
+        )
+        .unwrap();
+        assert_eq!(bad_cursor.object().unwrap()["synthetic"], Json::Bool(false));
+        let conflict = parse(
+            c.submit_ordinary_chat(
+                client.clone(),
+                "early".into(),
+                "fixture-conversation".into(),
+                "different synthetic input".into(),
+            )
+            .as_bytes(),
+        )
+        .unwrap();
+        assert_eq!(conflict.object().unwrap()["synthetic"], Json::Bool(false));
+        assert!(!conflict.encode().contains("remember blue"));
+        if !cancel {
+            std::fs::write(
+                path.join("native-agent-service-v1")
+                    .join(run)
+                    .join("ordinary-send-v1.db"),
+                b"malformed-current-fixture",
+            )
+            .unwrap();
+            let unavailable = events(&c, &client, "early");
+            assert_eq!(
+                unavailable.object().unwrap()["synthetic"],
+                Json::Bool(false)
+            );
+            assert!(!unavailable.encode().contains("remember blue"));
+        }
+        clean(path, c);
     }
 }
