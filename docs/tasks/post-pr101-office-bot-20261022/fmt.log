+        if !self.line.is_empty() || self.data_present || !self.done {
+            return Err("wire_stream_truncated".into());
+        }
+        let event = if self.call_seen {
+            if self.reason.as_deref() != Some("tool_calls") {
+                return Err("wire_tool_finish".into());
+            }
+            let call = self.complete_call()?;
+            if self.tools.is_some() {
+                ModelEvent::HostTool {
+                    call_ref: call.call_ref,
+                    name: call.name,
+                    arguments: wire_json::parse(call.value.as_bytes())?,
+                }
+            } else {
+                ModelEvent::Tool {
+                    call_ref: call.call_ref,
+                    name: call.name,
+                    value: call.value,
+                }
+            }
+        } else {
+            if self.reason.as_deref() != Some("stop") {
+                return Err("wire_answer_finish".into());
+            }
+            ModelEvent::Answer(self.text.clone())
+        };
+        Ok(DecodedTurn {
+            event,
+            usage: self.usage,
+        })
     }
 }
 
