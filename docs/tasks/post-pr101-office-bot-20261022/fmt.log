+use muyon_core_agent_lab::{
+    model::{ModelEvent, ModelRequest, ToolDefinition},
+    wire_json::{self, object, string, Json},
+    wire_provider::encode_registered_request,
+    wire_sse::Decoder,
+};
+fn tools() -> Vec<ToolDefinition> {
+    vec![ToolDefinition{name:"weather.peek".into(),wire_name:"t_42".into(),parameters:wire_json::parse(br#"{"type":"object","properties":{"station_key":{"type":"string"},"include_history":{"type":"boolean"}},"required":["station_key"],"additionalProperties":false}"#).unwrap()}]
 }
+fn request() -> ModelRequest {
+    ModelRequest {
+        task: "t1".into(),
+        attempt: "a1".into(),
+        turn: 1,
+        messages: vec![],
+        tools: vec!["weather.peek".into()],
+    }
+}
+fn history() -> Json {
+    Json::Array(vec![object([
+        ("role", string("user")),
+        ("content", string("weather?")),
+    ])])
+}
+fn stream(name: &str, args: &str, terminal: bool) -> Vec<u8> {
+    let function = object([("name", string(name)), ("arguments", string(args))]);
+    let call = object([
+        ("index", Json::Number("0".into())),
+        ("id", string("c1")),
+        ("type", string("function")),
+        ("function", function),
+    ]);
+    let delta = object([("tool_calls", Json::Array(vec![call]))]);
+    let choice = object([
+        ("index", Json::Number("0".into())),
+        ("delta", delta),
+        ("finish_reason", string("tool_calls")),
+    ]);
+    let chunk = object([("choices", Json::Array(vec![choice]))]);
+    let tail = if terminal { "data: [DONE]\n\n" } else { "" };
+    format!("data: {}\n\n{}", chunk.encode(), tail).into_bytes()
+}
