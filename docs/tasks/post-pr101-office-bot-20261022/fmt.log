+                return Err("closed_schema_required".into());
+            }
+            let p = map(get(s, "properties")?)?;
+            for schema in p.values() {
+                check(schema)?
+            }
+            if let Some(target) = map(s)?.get("data_ref") {
+                let target = target.string().map_err(|_| "reference_schema_required")?;
+                let (qualified, version_text) =
+                    target.rsplit_once('@').ok_or("reference_schema_required")?;
+                let (module, typ) = qualified
+                    .split_once('/')
+                    .ok_or("reference_schema_required")?;
+                if !name(module)
+                    || !name(typ)
+                    || version_text
+                        .parse::<u64>()
+                        .ok()
+                        .filter(|n| *n > 0)
+                        .is_none()
+                {
+                    return Err("reference_schema_required".into());
+                }
+                let expected = ["module_id", "type", "key", "revision", "schema_version"];
+                if p.len() != expected.len()
+                    || expected.iter().any(|k| !p.contains_key(*k))
+                    || array(s, "required")?.len() != expected.len()
+                {
+                    return Err("reference_schema_required".into());
+                }
+                for key in expected {
+                    if text(&p[key], "type")?
+                        != if key == "schema_version" {
+                            "integer"
+                        } else {
+                            "string"
+                        }
+                    {
+                        return Err("reference_schema_required".into());
+                    }
+                }
+            }
+            let mut seen = std::collections::BTreeSet::new();
+            for key in array(s, "required")? {
+                let k = key.string().map_err(|_| "required_key")?;
+                if !p.contains_key(k) || !seen.insert(k) {
+                    return Err("required_key".into());
+                }
+            }
+        }
+        "string" => {
+            keys(s, &["type", "enum"], &["type"])?;
+            if let Some(e) = map(s)?.get("enum") {
+                let a = e.array().map_err(|_| "enum")?;
+                if a.is_empty() || a.iter().any(|x| x.string().is_err()) {
+                    return Err("enum".into());
+                }
+            }
+        }
+        "integer" | "boolean" => keys(s, &["type"], &["type"])?,
+        "array" => {
+            keys(
+                s,
+                &["type", "items", "maxItems"],
+                &["type", "items", "maxItems"],
+            )?;
+            if get(s, "maxItems")?.integer().map_err(|_| "max_items")? > 128 {
+                return Err("max_items".into());
+            }
+            check(get(s, "items")?)?
+        }
+        _ => return Err("unsupported_schema".into()),
+    }
+    Ok(())
+}
+pub fn validate(s: &Json, v: &Json) -> Result<()> {
+    match text(s, "type")?.as_str() {
+        "object" => {
+            let m = map(v)?;
+            let p = map(get(s, "properties")?)?;
+            if m.keys().any(|k| !p.contains_key(k)) {
+                return Err("extra_property".into());
+            }
+            for key in array(s, "required")? {
+                if !m.contains_key(key.string().map_err(|_| "required")?) {
+                    return Err("missing_property".into());
+                }
+            }
+            for (k, v) in m {
+                validate(&p[k], v)?
+            }
+        }
+        "string" => {
+            v.string().map_err(|_| "string_required")?;
+            if let Some(e) = map(s)?.get("enum") {
+                if !e.array().map_err(|_| "enum")?.contains(v) {
+                    return Err("enum".into());
+                }
+            }
+        }
+        "integer" => {
+            integer(v)?;
+        }
+        "boolean" => {
+            if !matches!(v, Json::Bool(_)) {
+                return Err("boolean_required".into());
+            }
+        }
+        "array" => {
+            let a = v.array().map_err(|_| "array_required")?;
+            if a.len() > get(s, "maxItems")?.integer().map_err(|_| "max_items")? as usize {
+                return Err("max_items".into());
+            }
+            for x in a {
+                validate(get(s, "items")?, x)?
+            }
+        }
+        _ => return Err("unsupported_schema".into()),
+    }
+    Ok(())
+}
 
