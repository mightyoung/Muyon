+fn encoder_structure_exact_schema_and_role_pair_are_verified() {
+    use muyon_core_agent_lab::wire_json::{parse, Json};
+    let r = ModelRequest {
+        task: "t".into(),
+        attempt: "a".into(),
+        turn: 2,
+        messages: vec![],
+        tools: vec!["fixture.record".into()],
+    };
+    let h = vec![
+        NativeMessage::AssistantCall {
+            call_ref: "c1".into(),
+            name: "fixture.record".into(),
+            value: "hi".into(),
+        },
+        NativeMessage::ToolResult {
+            call_ref: "c1".into(),
+            value: "hi".into(),
+            receipt: "r-original".into(),
+        },
+    ];
+    let bytes = encode_request(&r, &h).unwrap();
+    let body = parse(&bytes).unwrap();
+    let o = body.object().unwrap();
+    let schema = o["tools"].array().unwrap()[0].object().unwrap()["function"]
+        .object()
+        .unwrap()["parameters"]
+        .object()
+        .unwrap();
+    assert_eq!(schema["additionalProperties"], Json::Bool(false));
+    assert_eq!(
+        schema["required"].array().unwrap()[0].string().unwrap(),
+        "value"
+    );
+    let messages = o["messages"].array().unwrap();
+    let call = messages[0].object().unwrap()["tool_calls"].array().unwrap()[0]
+        .object()
+        .unwrap();
+    assert_eq!(call["id"].string().unwrap(), "c1");
+    let tool = messages[1].object().unwrap();
+    assert_eq!(tool["role"].string().unwrap(), "tool");
+    assert_eq!(tool["tool_call_id"], call["id"]);
+    let result = parse(tool["content"].string().unwrap().as_bytes()).unwrap();
+    assert_eq!(
+        result.object().unwrap()["receipt"].string().unwrap(),
+        "r-original"
+    );
+    assert_eq!(result.object().unwrap()["value"].string().unwrap(), "hi");
+    assert!(encode_request(&r, &[h[1].clone()]).is_err());
+    assert!(encode_request(
+        &r,
+        &[h[0].clone(), NativeMessage::User("forged result".into())]
+    )
+    .is_err());
 }
