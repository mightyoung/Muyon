+fn physical_binding_replay_returns_original_and_altered_binding_conflicts() {
+    use muyon_core_agent_lab::store::{Binding, EffectStore, FixtureTool, ToolPort};
+    let dir = fixture("answer\t\n", &[]);
+    let mut tool = FixtureTool { dir: dir.clone() };
+    let binding = Binding {
+        invocation: "i-test".into(),
+        task: "t-test".into(),
+        attempt: "a-test".into(),
+        turn: 1,
+        scope: "fixture".into(),
+        value: "actual".into(),
+    };
+    let original = tool.execute_once(&binding).unwrap();
+    assert_eq!(tool.execute_once(&binding).unwrap(), original);
+    let mut changed = binding.clone();
+    changed.value = "altered".into();
+    assert!(tool.execute_once(&changed).is_err());
+    changed = binding.clone();
+    changed.scope = "other".into();
+    assert!(tool.execute_once(&changed).is_err());
+    changed = binding.clone();
+    changed.attempt = "stale".into();
+    assert!(tool.lookup(&changed).is_err());
+    assert_eq!(EffectStore::load(&dir).unwrap().receipts.len(), 1);
 }
