+fn alter_first_ref(value: &mut Json, key: &str, replacement: Json) -> bool {
+    if let Json::Object(map) = value {
+        if map.contains_key("schema_version") {
+            map.insert(key.into(), replacement);
+            return true;
+        }
+        for child in map.values_mut() {
