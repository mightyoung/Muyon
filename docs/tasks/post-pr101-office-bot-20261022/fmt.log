-    command(&dir,"cancel",&[]);let output=child.wait_with_output().unwrap();assert!(output.status.success());let text=String::from_utf8(output.stdout).unwrap();assert_eq!(field(&text,"reason"),"wire_cancelled");assert_eq!(field(&text,"effects"),"0");let pid=fs::read_to_string(dir.join("wire-capture/pid-1")).unwrap();assert!(!Path::new(&format!("/proc/{pid}")).exists());
+fn silent_stream_cancellation_is_observed_before_timeout() {
+    use std::{
+        thread,
+        time::{Duration, Instant},
+    };
+    let dir = fixture(TOOL, &["--wire-idle-ms", "1000", "--wire-total-ms", "2000"]);
+    fs::write(dir.parent().unwrap().join("silent"), "").unwrap();
+    let child = Command::new(env!("CARGO_BIN_EXE_muyon-core-agent-lab"))
+        .args(["run", "--dir"])
+        .arg(&dir)
+        .stdout(std::process::Stdio::piped())
+        .spawn()
+        .unwrap();
+    let start = Instant::now();
+    while !dir.join("wire-capture/request-1.json").exists() {
+        assert!(start.elapsed() < Duration::from_secs(5));
+        thread::sleep(Duration::from_millis(2));
+    }
+    command(&dir, "cancel", &[]);
+    let output = child.wait_with_output().unwrap();
+    assert!(output.status.success());
+    let text = String::from_utf8(output.stdout).unwrap();
+    assert_eq!(field(&text, "reason"), "wire_cancelled");
+    assert_eq!(field(&text, "effects"), "0");
+    let pid = fs::read_to_string(dir.join("wire-capture/pid-1")).unwrap();
+    assert!(!Path::new(&format!("/proc/{pid}")).exists());
 }
