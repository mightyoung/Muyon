+            p.dispatches
+        );
+    }
+    assert_eq!(
+        p.dispatches, 1,
+        "NATIVE_PORT_RED: registered generic read reaches the shared driver"
+    );
+    assert_eq!(m.turns, 2);
+    assert_eq!(a.state.status, "completed");
+    assert_eq!(a.state.answer, "done");
+    assert!(p.persists.get() >= 3);
+    std::fs::remove_dir(&a.dir).unwrap();
 }
 
