+                self.pos += 1;
+                self.space();
+                let mut values = Vec::new();
+                if self.take(b']') {
+                    return Ok(Json::Array(values));
+                }
+                loop {
+                    values.push(self.value(depth + 1)?);
+                    self.space();
+                    if self.take(b']') {
+                        break;
+                    }
+                    self.require(b',')?;
+                }
