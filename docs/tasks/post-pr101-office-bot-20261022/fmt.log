+fn reopened_inflight_is_terminal_and_never_resends() {
+    use muyon_core_agent_lab::agent::{Agent, Hooks, State};
+    let dir = fixture(TOOL, &[]);
+    let mut state = State::load(&dir).unwrap();
+    state.wire_counters.inflight = true;
+    state.counters.calls = 1;
+    state.counters.steps = 1;
+    state.wire_counters.sent = 10;
+    state.save(&dir).unwrap();
+    let mut agent = Agent::open(&dir).unwrap();
+    agent.run(&Hooks::default()).unwrap();
+    assert_eq!(agent.state.reason, "wire_interrupted");
+    assert_eq!(agent.state.counters.calls, 1);
+    assert_eq!(agent.state.wire_counters.sent, 10);
+    assert!(!dir.join("wire-capture").exists());
 }
