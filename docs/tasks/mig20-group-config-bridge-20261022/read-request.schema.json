{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "catalog"
            }
          },
          "required": [
            "operation"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "groups"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "after_group_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "operation",
            "limit"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "group"
            },
            "group_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": [
            "operation",
            "group_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "runs"
            },
            "group_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "after_run_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "operation",
            "group_id",
            "limit"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "run"
            },
            "group_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": [
            "operation",
            "group_id",
            "run_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "local_intent"
            },
            "group_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "intent_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": [
            "operation",
            "group_id",
            "intent_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "workflow"
            },
            "group_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            }
          },
          "required": [
            "operation",
            "group_id",
            "run_id"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request"
  ],
  "description": "Max8192 UTF-8 bytes, duplicate keys rejected. Host supplies native scope/actor/owner/ledger/session. Read only."
}
