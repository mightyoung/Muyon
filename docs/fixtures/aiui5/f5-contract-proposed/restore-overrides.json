    {"id": "cas-conflict-keeps-old", "action": "两个 controller 同 expectedRevision 保存", "expect": {"loser": "readOnly + saveError", "winnerBytesKept": true}},
    {"id": "save-over-unreadable-old-value", "action": "对不可读旧 bytes 调 save(expectedRevision=旧)", "expect": {"result": "false or throws", "rawBytesUnchanged": true}, "note": "变异 M4 的检出点"},
