[
  {
    "descriptor": {
      "id": "inquiry.create_inquiry",
      "effect": "write",
      "description": "为一个项目发起询价单：选定若干预算行和供应商，创建一张进行中的询价单。会修改本机询价数据（新增一张询价单），不发送给任何供应商；需要你确认后才执行。",
      "parameters": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "item_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "minItems": 1,
            "maxItems": 500
          },
          "supplier_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "project_id",
          "title",
          "item_ids",
          "supplier_ids"
        ],
        "additionalProperties": false
      },
      "result": {},
      "cancel": true,
      "selectable": true
    },
    "available": true,
    "reason": null,
    "scopes": [
      "selectedObjects"
    ],
    "dataModules": [
      "inquiry"
    ],
    "resultGuard": true,
    "destinationGuard": false,
    "effectIntent": false
  },
