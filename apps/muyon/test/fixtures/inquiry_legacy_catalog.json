  {
    "descriptor": {
      "id": "inquiry.query",
      "effect": "read",
      "description": "按字段条件筛选一类记录并计数。字段名见 describe；十进制按数值比较；列表字段任一元素满足即可；已删除和已合并的记录不返回。返回 total、returned、offset、has_more、next_offset、snapshot 和 rows；后续页须带 snapshot，数据变化则从头重查",
      "parameters": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "supplier",
              "contact",
              "product",
              "project",
              "quotation",
              "project_item",
              "inquiry",
              "product_param",
              "spec_request",
              "spec_item",
              "spec_response"
            ]
          },
          "where": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "ne",
                    "contains",
                    "gt",
                    "gte",
                    "lt",
                    "lte",
                    "is_null",
                    "not_null",
                    "in"
                  ]
                },
                "value": {
                  "description": "比较值；in 用数组；is_null/not_null 不需要",
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "maxItems": 100
                }
              },
              "required": [
                "field",
                "op"
              ],
              "additionalProperties": false
            }
          },
          "order_by": {
            "type": "string",
            "description": "排序字段，默认按最近修改"
          },
          "descending": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "description": "最多返回条数，默认 20，上限 50"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "跳过条数，默认 0；用 next_offset 继续读取"
          },
          "snapshot": {
            "type": "string",
            "description": "首次查询返回的 snapshot；offset > 0 时必填，并保持原筛选与排序。数据变化时报错，须从 offset 0 重查"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "result": {},
      "cancel": false,
      "selectable": true
    },
    "available": true,
    "reason": null,
    "scopes": [
      "global"
    ],
    "dataModules": [
      "inquiry"
    ],
    "resultGuard": false,
    "destinationGuard": false,
    "effectIntent": false
  },
  {
    "descriptor": {
      "id": "inquiry.related",
      "effect": "read",
      "description": "沿关系找引用了某条记录的记录，例如 link=quotation.supplier_id 取某供应商的报价，link=project_item.project_id 取某项目的预算行；后续页须带 snapshot，数据变化则从头重查",
      "parameters": {
        "type": "object",
        "properties": {
          "link": {
            "type": "string",
            "enum": [
              "supplier.merged_into",
              "product.merged_into",
              "contact.supplier_id",
              "quotation.supplier_id",
              "quotation.product_id",
              "quotation.contact_id",
              "quotation.project_id",
              "quotation.inquiry_id",
              "inquiry.project_id",
              "product_param.product_id",
              "spec_request.project_id",
              "spec_item.request_id",
              "spec_item.project_item_id",
              "spec_item.chosen_product_id",
              "spec_response.item_id",
              "spec_response.supplier_id",
              "spec_response.inquiry_id",
              "project_item.project_id",
              "project_item.product_id",
              "project_item.quotation_id",
              "inquiry.item_ids",
              "inquiry.supplier_ids"
            ]
          },
          "id": {
            "type": "string",
            "description": "被引用记录的 id"
          },
          "limit": {
            "type": "integer",
            "description": "最多返回条数，默认 20，上限 50"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "跳过条数，默认 0；用 next_offset 继续读取"
          },
          "snapshot": {
            "type": "string",
            "description": "首次查询返回的 snapshot；offset > 0 时必填，并保持原筛选与排序。数据变化时报错，须从 offset 0 重查"
          }
        },
        "required": [
          "link",
          "id"
        ],
        "additionalProperties": false
      },
      "result": {},
      "cancel": false,
      "selectable": true
    },
    "available": true,
    "reason": null,
    "scopes": [
      "global"
    ],
    "dataModules": [
      "inquiry"
    ],
    "resultGuard": false,
    "destinationGuard": false,
    "effectIntent": false
  },
  {
